/* 极速高德水印相机 v1.0 · 极简现代相机 Design Token */
page {
  --bg-page: #05070b;
  --bg-surface: #0e131d;
  --bg-elevated: #141a26;
  --bg-pill: rgba(255, 255, 255, 0.08);
  --bg-pill-hover: rgba(255, 255, 255, 0.14);
  --border-subtle: rgba(255, 255, 255, 0.12);
  --border-accent: rgba(56, 189, 248, 0.52);
  --accent-blue: #38bdf8;
  --accent-blue-solid: #0284c7;
  --accent-blue-bg: rgba(14, 165, 233, 0.18);
  --accent-emerald: #34d399;
  --accent-emerald-bg: rgba(16, 185, 129, 0.16);
  --accent-amber: #fbbf24;
  --accent-amber-bg: rgba(245, 158, 11, 0.16);
  --accent-danger: #f87171;
  --text-primary: #f8fafc;
  --text-secondary: #cbd5e1;
  --text-muted: #94a3b8;

  background-color: var(--bg-page);
  color: var(--text-primary);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", "Microsoft YaHei", sans-serif;
  box-sizing: border-box;
}

.mono {
  font-family: "JetBrains Mono", Menlo, Monaco, Consolas, monospace;
}

.accent {
  color: var(--accent-blue) !important;
}

.emerald {
  color: var(--accent-emerald) !important;
}

.amber {
  color: var(--accent-amber) !important;
}

.danger {
  color: var(--accent-danger) !important;
}
