/* 极速高德水印相机 v2.0 · 清爽轻盈日间极简 Design Token */
page {
  --bg-page: #f5f6f8;
  --bg-surface: #ffffff;
  --bg-elevated: #f8fafc;
  --bg-muted: #f1f5f9;
  --bg-pill: #f1f5f9;
  --bg-pill-hover: #e2e8f0;
  --border-subtle: #eaedf2;
  --border-strong: #d8dee6;
  --border-accent: #2563eb;
  --accent-blue: #2563eb;
  --accent-blue-solid: #2563eb;
  --accent-blue-soft: rgba(37, 99, 235, 0.08);
  --accent-blue-bg: rgba(37, 99, 235, 0.1);
  --accent-emerald: #07c160;
  --accent-emerald-bg: rgba(7, 193, 96, 0.12);
  --accent-amber: #d97706;
  --accent-amber-bg: rgba(217, 119, 6, 0.12);
  --accent-danger: #ef4444;
  --text-primary: #111827;
  --text-secondary: #4b5563;
  --text-muted: #9ca3af;
  --shadow-sheet: 0 -10rpx 36rpx rgba(15, 23, 42, 0.08);
  --shadow-card: 0 4rpx 16rpx rgba(15, 23, 42, 0.05);

  background-color: var(--bg-page);
  color: var(--text-primary);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", "Microsoft YaHei", sans-serif;
  box-sizing: border-box;
}

.mono {
  font-family: "JetBrains Mono", Menlo, Monaco, Consolas, monospace;
}

.accent {
  color: var(--accent-blue) !important;
}

.emerald {
  color: var(--accent-emerald) !important;
}

.amber {
  color: var(--accent-amber) !important;
}

.danger {
  color: var(--accent-danger) !important;
}
