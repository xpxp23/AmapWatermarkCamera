<view class="gallery-page">
  <!-- 顶部清爽白底导航栏（对齐微信胶囊） -->
  <view
    class="glass-nav"
    style="padding-top: {{menuBtnTop}}px; height: {{menuBtnHeight}}px; padding-right: {{menuBtnRightSpace}}px;"
  >
    <view class="nav-left-btn" bindtap="goBackCamera">
      <view class="ico-sm ico-back"></view>
      <text class="nav-txt">相机</text>
    </view>

    <view class="nav-center-title">水印相册 ({{photoCount}})</view>

    <view wx:if="{{photoCount > 0}}" class="nav-right-btn {{multiSelectMode ? 'active' : ''}}" bindtap="toggleMultiSelect">
      {{multiSelectMode ? '取消' : '多选'}}
    </view>
  </view>

  <scroll-view scroll-y class="gallery-scroll">
    <!-- 顶部通栏系统相册批量加水印入口 -->
    <view class="single-entry-card" bindtap="openSystemAlbumBatch">
      <view class="entry-left">
        <view class="entry-icon-box">
          <view class="ico-md ico-batch"></view>
        </view>
        <view class="entry-text-col">
          <view class="entry-title">系统相册批量加水印</view>
          <view class="entry-sub">一次选 20 张 · 自动读取 EXIF 原拍时间与 GPS 地点</view>
        </view>
      </view>
      <view class="entry-go-pill">去选图</view>
    </view>

    <!-- 离线拍摄待补签横幅 -->
    <view wx:if="{{offlinePendingCount > 0}}" class="offline-sync-banner" bindtap="handleReconcileOffline">
      <view class="offline-sync-text">
        <text class="offline-sync-title">有 {{offlinePendingCount}} 张离线照片待补签授时与地名</text>
        <text class="offline-sync-sub">联网后点击即可自动补齐周边地点与权威时间并无损重绘</text>
      </view>
      <view class="offline-sync-btn">{{isReconcilingOffline ? '补签中...' : '一键补签'}}</view>
    </view>

    <!-- 双轨存储空间估算进度条 + 一键清理底图 -->
    <view class="storage-card">
      <view class="storage-head">
        <text class="storage-info">空间 {{storage.usedMB}}MB / {{storage.quotaMB}}MB · 成品 {{storage.photoCount}}/{{storage.maxPhotos}} · 底图 {{storage.rawCount}}/{{storage.maxRaw}}</text>
        <text wx:if="{{storage.rawCount > 0}}" class="storage-clean-btn" bindtap="handleClearRawOriginals">清理底图</text>
      </view>
      <view class="storage-track">
        <view class="storage-fill {{storage.percent > 80 ? 'warn' : ''}}" style="width: {{storage.percent}}%;"></view>
      </view>
    </view>

    <!-- 空状态 -->
    <view wx:if="{{photoCount === 0}}" class="empty-state">
      <view class="empty-icon-circle">
        <view class="ico-lg ico-camera"></view>
      </view>
      <view class="empty-title">暂无应用内照片</view>
      <view class="empty-desc">返回相机拍摄即可自动收录（最多保留 120 张成品与缩略图，最近 25 张支持无损补加或重绘水印）。</view>
      <button class="empty-btn" bindtap="goBackCamera">返回相机拍摄</button>
    </view>

    <!-- 按日期吸顶分组的 3 列正方形网格 -->
    <block wx:else>
      <view wx:for="{{dateGroups}}" wx:key="date" class="date-group">
        <view class="date-sticky-header">
          <text class="date-label">{{item.date}}</text>
          <text class="date-count">{{item.count}} 张</text>
        </view>

        <view class="grid-3col">
          <view
            wx:for="{{item.items}}"
            wx:for-item="photo"
            wx:key="id"
            class="grid-cell {{selectedMap[photo.id] ? 'selected' : ''}}"
            data-id="{{photo.id}}"
            bindtap="onTapGridPhoto"
          >
            <image src="{{photo.thumbPath}}" mode="aspectFill" lazy-load="{{true}}" class="grid-thumb" />

            <!-- 多选复选圆点 -->
            <view wx:if="{{multiSelectMode}}" class="select-check {{selectedMap[photo.id] ? 'checked' : ''}}">
              {{selectedMap[photo.id] ? '✓' : ''}}
            </view>

            <!-- 极简左下角标 -->
            <view wx:if="{{photo.offlinePending}}" class="corner-badge bl offline">待补签</view>
            <view wx:elif="{{photo.noWatermark}}" class="corner-badge bl plain">无水印</view>
            <view wx:elif="{{photo.antiTamper}}" class="corner-badge bl shield">防伪</view>
            <view wx:elif="{{photo.hasRaw}}" class="corner-badge bl edit">可改</view>

            <!-- 极简右下角标：拍摄时间 -->
            <view wx:if="{{photo.hm}}" class="corner-badge br time">{{photo.hm}}</view>
          </view>
        </view>
      </view>
    </block>
  </scroll-view>

  <!-- 多选态底部批量操作栏 -->
  <view wx:if="{{multiSelectMode}}" class="multi-bar">
    <view class="multi-sel-all" bindtap="selectAllPhotos">
      {{selectedCount === photoCount ? '取消全选' : '全选'}} ({{selectedCount}})
    </view>
    <view class="multi-actions">
      <view class="multi-btn blue" bindtap="batchSaveToSystemAlbum">存相册</view>
      <view class="multi-btn emerald" bindtap="batchExportLedgerText">导台账</view>
      <view class="multi-btn danger" bindtap="batchDeleteSelected">删除</view>
    </view>
  </view>

  <!-- 离线补签重绘备用 Canvas -->
  <canvas type="2d" id="galleryOfflineCanvas" style="width: 1080px; height: 1440px; position: fixed; left: -9999px; top: -9999px;"></canvas>
</view>
