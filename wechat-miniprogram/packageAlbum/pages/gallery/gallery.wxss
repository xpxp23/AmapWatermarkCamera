.gallery-page {
  width: 100vw;
  height: 100vh;
  background-color: #050811;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.glass-nav {
  background-color: rgba(11, 19, 43, 0.9);
  backdrop-filter: blur(12px);
  border-bottom: 1px solid rgba(148, 163, 184, 0.16);
  padding-left: 20rpx;
  padding-bottom: 14rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: content-box;
}

.nav-left-btn {
  display: flex;
  align-items: center;
  padding: 6rpx 16rpx 6rpx 8rpx;
  border-radius: 28rpx;
  background-color: rgba(30, 41, 59, 0.78);
}

.nav-chevron {
  font-size: 36rpx;
  line-height: 1;
  margin-right: 4rpx;
}

.nav-txt {
  font-size: 24rpx;
}

.nav-center-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #ffffff;
}

.nav-right-btn {
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  background-color: rgba(30, 41, 59, 0.85);
  border: 1px solid rgba(148, 163, 184, 0.25);
  font-size: 23rpx;
  color: #cbd5e1;
}

.nav-right-btn.active {
  background-color: rgba(2, 132, 199, 0.28);
  border-color: #38bdf8;
  color: #38bdf8;
  font-weight: bold;
}

.gallery-scroll {
  flex: 1;
  min-height: 0;
  padding: 18rpx 18rpx 32rpx;
  box-sizing: border-box;
}

/* 顶部系统相册融合双入口 */
.dual-entry-row {
  display: flex;
  gap: 14rpx;
  margin-bottom: 16rpx;
}

.entry-card {
  flex: 1;
  border-radius: 20rpx;
  padding: 18rpx 16rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
  border: 1px solid rgba(148, 163, 184, 0.22);
}

.entry-card.blue {
  background: linear-gradient(135deg, rgba(2, 132, 199, 0.28), rgba(15, 23, 42, 0.92));
  border-color: rgba(56, 189, 248, 0.45);
}

.entry-card.emerald {
  background: linear-gradient(135deg, rgba(5, 150, 105, 0.28), rgba(15, 23, 42, 0.92));
  border-color: rgba(52, 211, 153, 0.45);
}

.entry-icon {
  font-size: 38rpx;
  flex-shrink: 0;
}

.entry-title {
  font-size: 24rpx;
  font-weight: bold;
  color: #ffffff;
}

.entry-sub {
  font-size: 18.5rpx;
  color: #94a3b8;
  margin-top: 4rpx;
}

/* 存储进度条 */
.storage-card {
  background-color: #0f172a;
  border: 1px solid rgba(148, 163, 184, 0.18);
  border-radius: 16rpx;
  padding: 14rpx 18rpx;
  margin-bottom: 18rpx;
}

.storage-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.storage-info {
  font-size: 20rpx;
  color: #94a3b8;
}

.storage-clean-btn {
  font-size: 20rpx;
  color: #fbbf24;
  font-weight: bold;
  flex-shrink: 0;
  margin-left: 12rpx;
}

.storage-track {
  height: 8rpx;
  background-color: #1e293b;
  border-radius: 4rpx;
  overflow: hidden;
}

.storage-fill {
  height: 100%;
  background: linear-gradient(90deg, #38bdf8, #34d399);
}

.storage-fill.warn {
  background: linear-gradient(90deg, #f59e0b, #ef4444);
}

/* 空状态 */
.empty-state {
  margin-top: 80rpx;
  padding: 40rpx;
  text-align: center;
}

.empty-icon { font-size: 84rpx; }
.empty-title { font-size: 30rpx; font-weight: bold; margin-top: 16rpx; }
.empty-desc { font-size: 22rpx; color: #94a3b8; margin-top: 12rpx; line-height: 1.6; }
.empty-btn {
  margin-top: 28rpx;
  background-color: #0284c7;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: bold;
  border-radius: 20rpx;
}

/* 按日期吸顶分组的 3 列正方形网格 */
.date-group {
  margin-bottom: 22rpx;
}

.date-sticky-header {
  position: sticky;
  top: 0;
  z-index: 5;
  background-color: rgba(5, 8, 17, 0.92);
  padding: 10rpx 6rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.date-label {
  font-size: 23rpx;
  font-weight: bold;
  color: #e2e8f0;
}

.date-count {
  font-size: 20rpx;
  color: #64748b;
}

.grid-3col {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.grid-cell {
  width: calc((100% - 16rpx) / 3);
  height: 230rpx;
  border-radius: 12rpx;
  overflow: hidden;
  position: relative;
  background-color: #1e293b;
  border: 2rpx solid transparent;
  box-sizing: border-box;
}

.grid-cell.selected {
  border-color: #38bdf8;
}

.grid-thumb {
  width: 100%;
  height: 100%;
}

.select-check {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  width: 38rpx;
  height: 38rpx;
  border-radius: 19rpx;
  border: 2rpx solid #ffffff;
  background-color: rgba(0, 0, 0, 0.45);
  color: #ffffff;
  font-size: 22rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
}

.select-check.checked {
  background-color: #0284c7;
  border-color: #38bdf8;
}

.corner-badge {
  position: absolute;
  padding: 2rpx 8rpx;
  border-radius: 8rpx;
  font-size: 18rpx;
  background-color: rgba(0, 0, 0, 0.62);
  color: #ffffff;
}

.corner-badge.bl {
  left: 8rpx;
  bottom: 8rpx;
}

.corner-badge.bl.shield {
  background-color: rgba(5, 150, 105, 0.85);
}

.corner-badge.bl.edit {
  background-color: rgba(2, 132, 199, 0.82);
}

.corner-badge.br {
  right: 8rpx;
  bottom: 8rpx;
  font-size: 17rpx;
}

/* 多选底部栏 */
.multi-bar {
  background-color: #0b132b;
  border-top: 1px solid rgba(148, 163, 184, 0.18);
  padding: 16rpx 20rpx calc(18rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.multi-sel-all {
  font-size: 23rpx;
  color: #38bdf8;
  font-weight: bold;
}

.multi-actions {
  display: flex;
  gap: 12rpx;
}

.multi-btn {
  padding: 12rpx 20rpx;
  border-radius: 16rpx;
  font-size: 22rpx;
  font-weight: bold;
  color: #ffffff;
}

.multi-btn.blue { background-color: #0284c7; }
.multi-btn.emerald { background-color: #059669; }
.multi-btn.danger { background-color: #dc2626; }

/* 验真弹窗 */
.verify-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.72);
  display: flex;
  align-items: flex-end;
  z-index: 99;
}

.verify-dialog {
  width: 100%;
  background-color: #0f172a;
  border-radius: 28rpx 28rpx 0 0;
  padding: 26rpx 26rpx calc(30rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.verify-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.verify-title { font-size: 28rpx; font-weight: bold; }
.verify-close { font-size: 28rpx; color: #94a3b8; padding: 8rpx; }

.verify-banner {
  border-radius: 16rpx;
  padding: 16rpx;
  margin-bottom: 14rpx;
  background-color: #1e293b;
}

.verify-banner.VERIFIED {
  background-color: rgba(5, 150, 105, 0.25);
  border: 1px solid #34d399;
}

.verify-banner.TAMPERED {
  background-color: rgba(220, 38, 38, 0.25);
  border: 1px solid #f87171;
}

.vb-badge { font-size: 24rpx; font-weight: bold; }
.vb-title { font-size: 26rpx; font-weight: bold; margin-top: 6rpx; }
.vb-desc { font-size: 21rpx; color: #cbd5e1; margin-top: 6rpx; line-height: 1.5; }

.verify-kv {
  background-color: #0b132b;
  border-radius: 14rpx;
  padding: 12rpx 16rpx;
}

.kv-row {
  display: flex;
  justify-content: space-between;
  padding: 8rpx 0;
  font-size: 21rpx;
  border-bottom: 1px solid rgba(148, 163, 184, 0.12);
}

.kv-k { color: #94a3b8; }
.kv-v { color: #ffffff; }

.verify-actions {
  display: flex;
  gap: 14rpx;
  margin-top: 18rpx;
}

.v-btn {
  flex: 1;
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 16rpx;
  font-size: 24rpx;
  font-weight: bold;
  color: #ffffff;
}

.v-btn.blue { background-color: #0284c7; }
.v-btn.emerald { background-color: #059669; }

.offline-sync-banner {
  margin: 0 24rpx 18rpx;
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  background-color: rgba(180, 83, 9, 0.22);
  border: 1px solid rgba(251, 191, 36, 0.45);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.offline-sync-text {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
.offline-sync-title {
  font-size: 24rpx;
  font-weight: 600;
  color: #fde68a;
}
.offline-sync-sub {
  font-size: 19rpx;
  color: #cbd5e1;
}
.offline-sync-btn {
  padding: 10rpx 20rpx;
  border-radius: 14rpx;
  background-color: #d97706;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 600;
  flex-shrink: 0;
}
.corner-badge.offline {
  background-color: rgba(180, 83, 9, 0.9);
  color: #fef3c7;
  font-size: 17rpx;
  padding: 2rpx 8rpx;
}
