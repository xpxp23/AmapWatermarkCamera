  height: 1px;
  padding: 0 24rpx;
  box-sizing: border-box;
}

.wm-edit-row {
  min-height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid #f1f5f9;
  padding: 10rpx 4rpx;
  box-sizing: border-box;
}

.wm-row-switch-wrap {
  width: 96rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  transform: scale(0.84);
  transform-origin: left center;
}

.wm-row-swatch-wrap {
  width: 96rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  padding-left: 16rpx;
  box-sizing: border-box;
}

.wm-row-swatch {
  width: 36rpx;
  height: 36rpx;
  border-radius: 18rpx;
  border: 3rpx solid #ffffff;
  box-shadow: 0 2rpx 8rpx rgba(15, 23, 42, 0.16);
}

.wm-row-body {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  padding-right: 12rpx;
}

.wm-row-body.muted .wm-row-lbl,
.wm-row-body.muted .wm-row-val {
  color: #9ca3af;
}

.wm-row-lbl {
  font-size: 27rpx;
  font-weight: 600;
  color: #111827;
  flex-shrink: 0;
}

.wm-row-val {
  flex: 1;
  font-size: 26rpx;
  color: #4b5563;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.wm-editor-footer {
  padding: 16rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #eaedf2;
  background-color: #ffffff;
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-shrink: 0;
}

.wm-btn-secondary {
  height: 82rpx;
  line-height: 82rpx;
  padding: 0 32rpx;
  border-radius: 18rpx;
  background-color: #f3f4f6;
  color: #374151;
  font-size: 27rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.wm-btn-primary {
  flex: 1;
  height: 82rpx;
  line-height: 82rpx;
  text-align: center;
  border-radius: 18rpx;
  background-color: #2563eb;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
}

.wm-btn-primary.full {
  width: 100%;
}

/* ==================== View 3：单项内部下钻编辑 ==================== */
.wm-field-header {
  height: 92rpx;
  padding: 0 24rpx;
  border-bottom: 1rpx solid #eaedf2;
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-shrink: 0;
}

.wm-field-back {
  display: inline-flex;
  align-items: center;
  gap: 4rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #111827;
  padding: 8rpx 10rpx 8rpx 0;
}

.wm-field-title {
  font-size: 29rpx;
  font-weight: 700;
  color: #111827;
}

.wm-field-scroll {
  flex: 1;
  height: 1px;
  padding: 18rpx 24rpx;
  box-sizing: border-box;
}

.field-info-card {
  background-color: #f8fafc;
  border: 1rpx solid #eaedf2;
  border-radius: 18rpx;
  padding: 20rpx;
  margin: 14rpx 0;
}

.field-info-k {
  font-size: 21rpx;
  color: #6b7280;
}

.field-info-v {
  font-size: 27rpx;
  font-weight: 700;
  color: #111827;
  margin-top: 6rpx;
}

.field-info-sub {
  font-size: 21rpx;
  color: #6b7280;
  margin-top: 6rpx;
}

.style-dots-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 14rpx;
}

.color-chip {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background-color: #f3f4f6;
  border: 2rpx solid transparent;
  font-size: 23rpx;
  color: #374151;
}

.color-chip.selected {
  background-color: #eff6ff;
  border-color: #2563eb;
  color: #2563eb;
  font-weight: 600;
}

.color-dot {
  width: 24rpx;
  height: 24rpx;
  border-radius: 12rpx;
}
