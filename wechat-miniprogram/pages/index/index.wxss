/* 极速高德水印相机 v9.0.0 · 主取景页精简样式（基于全局 CSS Token，移除重复胶囊与巨型相册样式） */

.page-root {
  width: 100vw;
  height: 100vh;
  background-color: var(--bg-page);
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  overflow: hidden;
}

/* 1. 顶部 5 键精简工具栏 */
.top-bar {
  background-color: var(--bg-page);
  padding-left: 20rpx;
  padding-bottom: 12rpx;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  z-index: 20;
  box-sizing: content-box;
}

.top-left-group {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.top-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.top-icon-pill {
  min-width: 50rpx;
  height: 44rpx;
  padding: 0 10rpx;
  border-radius: 22rpx;
  background-color: var(--bg-pill);
  border: 1px solid var(--border-subtle);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 25rpx;
  color: var(--text-primary);
}

.top-icon-pill.accent {
  border-color: var(--border-accent);
  background-color: var(--accent-blue-bg);
  color: var(--accent-blue);
}

.top-icon-pill.emerald {
  border-color: rgba(52, 211, 153, 0.55);
  background-color: var(--accent-emerald-bg);
  color: var(--accent-emerald);
}

.top-icon-pill.amber {
  border-color: rgba(251, 191, 36, 0.55);
  background-color: var(--accent-amber-bg);
  color: var(--accent-amber);
}

.top-label {
  font-size: 19rpx;
  color: var(--text-secondary);
  margin-top: 4rpx;
}

/* 2. 中央取景器 */
.viewfinder-wrap {
  flex: 1;
  width: 100%;
  position: relative;
  overflow: hidden;
  background-color: #0a0e17;
}

.camera-view {
  width: 100%;
  height: 100%;
  position: absolute;
  left: 0;
  top: 0;
  z-index: 1;
}

.viewfinder-hud-layer {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 5;
  pointer-events: auto;
}

.camera-boot-overlay {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: radial-gradient(circle at center, #111c35 0%, #070b14 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 15;
}

.boot-lens-ring {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  border: 4rpx solid var(--border-accent);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

.boot-lens-core {
  width: 56rpx;
  height: 56rpx;
  border-radius: 28rpx;
  background-color: rgba(56, 189, 248, 0.35);
}

.boot-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #f8fafc;
}

.boot-sub {
  font-size: 21rpx;
  color: #64748b;
  margin-top: 8rpx;
}

.grid-lines-overlay {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  pointer-events: none;
}

.grid-v {
  position: absolute;
  top: 0;
  bottom: 0;
  width: 1px;
  background-color: rgba(255, 255, 255, 0.24);
}
.grid-v.v1 { left: 33.33%; }
.grid-v.v2 { left: 66.66%; }

.grid-h {
  position: absolute;
  left: 0;
  right: 0;
  height: 1px;
  background-color: rgba(255, 255, 255, 0.24);
}
.grid-h.h1 { top: 33.33%; }
.grid-h.h2 { top: 66.66%; }

.gps-pill {
  position: absolute;
  top: 20rpx;
  left: 20rpx;
  background-color: rgba(11, 19, 43, 0.85);
  border: 1px solid rgba(56, 189, 248, 0.45);
  border-radius: 32rpx;
  padding: 8rpx 20rpx;
  display: flex;
  align-items: center;
  z-index: 10;
}

.gps-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 7rpx;
  margin-right: 12rpx;
  background-color: var(--accent-emerald);
}

.gps-dot.searching { background-color: var(--accent-amber); }
.gps-dot.manual { background-color: #f59e0b; }
.gps-dot.denied { background-color: var(--accent-danger); }

.gps-pill-text {
  font-size: 21rpx;
  color: var(--text-primary);
}

.zoom-floating-btn {
  position: absolute;
  right: 22rpx;
  top: 44%;
  width: 72rpx;
  height: 72rpx;
  border-radius: 36rpx;
  background-color: rgba(11, 19, 43, 0.72);
  border: 2rpx solid rgba(255, 255, 255, 0.85);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
}

.zoom-txt {
  color: var(--text-primary);
  font-size: 21rpx;
  font-weight: bold;
}

.countdown-overlay {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 16;
  pointer-events: none;
}

.countdown-num {
  font-size: 160rpx;
  font-weight: bold;
  color: var(--text-primary);
  text-shadow: 0 6rpx 24rpx rgba(0, 0, 0, 0.85);
}

.shutter-flash-mask {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(255, 255, 255, 0.85);
  z-index: 18;
  pointer-events: none;
}

/* 好友分享位置横幅 */
.shared-jump-banner {
  position: absolute;
  top: 90rpx;
  left: 22rpx;
  right: 22rpx;
  background-color: rgba(15, 23, 42, 0.96);
  border: 2rpx solid var(--accent-blue);
  border-radius: 24rpx;
  padding: 24rpx;
  z-index: 14;
}

.shared-banner-title {
  font-size: 28rpx;
  font-weight: bold;
  color: var(--text-primary);
}

.shared-banner-coord {
  font-size: 23rpx;
  color: var(--accent-blue);
  margin-top: 8rpx;
}

.shared-banner-verify {
  font-size: 21rpx;
  margin-top: 8rpx;
  padding: 6rpx 12rpx;
  border-radius: 10rpx;
}

.shared-banner-verify.ok {
  background-color: var(--accent-emerald-bg);
  color: var(--accent-emerald);
}

.shared-banner-verify.warn {
  background-color: var(--accent-amber-bg);
  color: var(--accent-amber);
}

.shared-banner-actions {
  display: flex;
  margin-top: 18rpx;
  gap: 16rpx;
}

.shared-btn-nav {
  flex: 1;
  background-color: #059669;
  color: var(--text-primary);
  font-size: 24rpx;
  font-weight: bold;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 16rpx;
}

.shared-btn-close {
  width: 120rpx;
  background-color: #334155;
  color: var(--text-secondary);
  font-size: 24rpx;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 16rpx;
}

/* 模板快切条 */
.tpl-bar {
  background-color: #060911;
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: 12rpx 16rpx;
  border-top: 1px solid rgba(148, 163, 184, 0.14);
}

.tpl-pill {
  font-size: 22rpx;
  color: var(--text-muted);
  padding: 8rpx 18rpx;
  border-radius: 24rpx;
}

.tpl-pill.active {
  background-color: var(--accent-blue-bg);
  color: var(--accent-blue);
  font-weight: bold;
  border: 1px solid var(--border-accent);
}

/* 3. 底部对称 5 槽主控栏 */
.bottom-bar {
  background-color: var(--bg-page);
  padding: 16rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.bot-btn {
  width: 112rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.thumb-circle,
.thumb-placeholder,
.bot-icon-ring {
  width: 78rpx;
  height: 78rpx;
  border-radius: 39rpx;
  border: 2rpx solid rgba(148, 163, 184, 0.35);
  background-color: var(--bg-elevated);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
}

.bot-icon-ring.active {
  border-color: var(--accent-blue);
  background-color: var(--accent-blue-bg);
}

.bot-icon-ring.batch {
  border-color: rgba(52, 211, 153, 0.55);
  background-color: rgba(5, 150, 105, 0.18);
}

.bot-label {
  font-size: 20rpx;
  color: var(--text-secondary);
  margin-top: 8rpx;
  white-space: nowrap;
}

.shutter-outer {
  width: 136rpx;
  height: 136rpx;
  border-radius: 68rpx;
  border: 6rpx solid #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
}

.shutter-outer.optical {
  border-color: var(--accent-blue);
}

.shutter-outer.counting {
  border-color: var(--accent-danger);
}

.shutter-inner {
  width: 110rpx;
  height: 110rpx;
  border-radius: 55rpx;
  background-color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
}

.shutter-outer.counting .shutter-inner {
  background-color: var(--accent-danger);
}

.shutter-stop-txt {
  font-size: 26rpx;
  font-weight: bold;
  color: #ffffff;
}

/* ==================== 统一弹窗与控件样式 ==================== */
.modal-mask {
  width: 100vw;
  height: 100vh;
  background-color: rgba(0, 0, 0, 0.58);
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.bottom-sheet-mask {
  background-color: rgba(0, 0, 0, 0.25);
}

.dialog-card {
  width: 100%;
  max-height: 82vh;
  overflow-y: auto;
  background-color: var(--bg-elevated);
  border-top: 2rpx solid rgba(56, 189, 248, 0.35);
  border-radius: 32rpx 32rpx 0 0;
  padding: 28rpx 28rpx calc(32rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.bottom-sheet-card {
  max-height: 62vh;
}

.dialog-header-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.dialog-title {
  font-size: 30rpx;
  font-weight: bold;
  color: var(--text-primary);
}

.dialog-close-x {
  width: 52rpx;
  height: 52rpx;
  border-radius: 26rpx;
  background-color: rgba(51, 65, 85, 0.65);
  color: var(--text-secondary);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
}

.setting-section-label {
  font-size: 22rpx;
  color: var(--text-muted);
  margin: 18rpx 0 10rpx;
}

/* 统一选项胶囊体系 (合并原 7 套重复胶囊样式) */
.mode-switch-row,
.preset-row {
  display: flex;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.mode-option,
.preset-btn {
  flex: 1;
  text-align: center;
  padding: 14rpx 8rpx;
  border-radius: 14rpx;
  background-color: var(--bg-pill);
  border: 1px solid var(--border-subtle);
  font-size: 22rpx;
  color: var(--text-secondary);
}

.mode-option.selected,
.preset-btn:active {
  background-color: var(--accent-blue-bg);
  border-color: var(--accent-blue);
  color: var(--accent-blue);
  font-weight: bold;
}

.chip-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 10rpx;
}

.quick-chip,
.matrix-chip {
  padding: 10rpx 18rpx;
  border-radius: 20rpx;
  background-color: var(--bg-pill);
  border: 1px solid var(--border-subtle);
  font-size: 22rpx;
  color: var(--text-secondary);
}

.quick-chip.active,
.matrix-chip.on {
  background-color: var(--accent-blue-bg);
  border-color: var(--accent-blue);
  color: var(--accent-blue);
  font-weight: bold;
}

.quick-chip.clear {
  border-color: rgba(248, 113, 113, 0.55);
  color: var(--accent-danger);
}

.toggle-matrix {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.custom-appearance-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.color-dots-group,
.scale-pills-group {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.color-dot {
  width: 42rpx;
  height: 42rpx;
  border-radius: 21rpx;
  border: 4rpx solid transparent;
}

.color-dot.selected {
  border-color: #ffffff;
}

.mini-opt {
  padding: 8rpx 14rpx;
  border-radius: 12rpx;
  font-size: 20rpx;
  background-color: var(--bg-pill);
  border: 1px solid var(--border-subtle);
  color: var(--text-secondary);
}

.mini-opt.selected {
  background-color: var(--accent-blue-bg);
  border-color: var(--accent-blue);
  color: var(--accent-blue);
  font-weight: bold;
}

/* 开关行与输入项 */
.switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1px solid rgba(148, 163, 184, 0.14);
  font-size: 24rpx;
  color: var(--text-primary);
}

.switch-row.compact {
  padding: 8rpx 0;
  border-bottom: none;
}

.switch-row.compact-top {
  margin-top: 8rpx;
}

.switch-label-col {
  display: flex;
  flex-direction: column;
  padding-right: 16rpx;
}

.switch-main {
  font-size: 24rpx;
  color: var(--text-primary);
}

.switch-sub {
  font-size: 19rpx;
  color: var(--text-muted);
  margin-top: 4rpx;
}

.ntp-status-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background-color: rgba(15, 23, 42, 0.9);
  border: 1px solid rgba(56, 189, 248, 0.25);
  border-radius: 14rpx;
  padding: 12rpx 16rpx;
  margin: 12rpx 0;
}

.ntp-status-label {
  font-size: 21rpx;
  color: var(--text-secondary);
}

.ntp-recal-btn {
  font-size: 21rpx;
  color: var(--accent-blue);
  font-weight: bold;
}

.input-group {
  margin-bottom: 16rpx;
}

.label-with-action {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.input-label,
.input-label-inline {
  font-size: 22rpx;
  color: var(--text-muted);
}

.btn-pick-name-only {
  font-size: 21rpx;
  color: var(--accent-blue);
  background-color: var(--accent-blue-bg);
  padding: 6rpx 14rpx;
  border-radius: 12rpx;
}

.text-input {
  width: 100%;
  height: 76rpx;
  background-color: #1e293b;
  border: 1px solid var(--border-subtle);
  border-radius: 14rpx;
  padding: 0 20rpx;
  color: var(--text-primary);
  font-size: 25rpx;
  box-sizing: border-box;
}

.text-input.locked {
  opacity: 0.6;
}

/* 地点校准面板 */
.coord-source-banner {
  background-color: rgba(15, 23, 42, 0.9);
  border: 1px solid rgba(52, 211, 153, 0.45);
  border-radius: 16rpx;
  padding: 16rpx 18rpx;
  margin-bottom: 18rpx;
}

.coord-source-banner.manual {
  border-color: rgba(245, 158, 11, 0.55);
}

.source-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.source-tag {
  font-size: 22rpx;
  font-weight: bold;
  color: var(--accent-emerald);
}

.coord-source-banner.manual .source-tag {
  color: var(--accent-amber);
}

.source-restore-btn {
  font-size: 21rpx;
  color: var(--accent-blue);
  font-weight: bold;
}

.source-coord-line {
  font-size: 22rpx;
  color: var(--text-primary);
}

.source-coord-line.sub {
  font-size: 20rpx;
  color: var(--text-muted);
  margin-top: 4rpx;
}

.map-relocate-box {
  background-color: rgba(30, 41, 59, 0.55);
  border-radius: 16rpx;
  padding: 16rpx;
  margin: 14rpx 0 18rpx;
}

.relocate-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.relocate-title {
  font-size: 23rpx;
  font-weight: bold;
  color: var(--text-primary);
}

.relocate-lock-badge {
  font-size: 20rpx;
  color: var(--accent-emerald);
}

.relocate-desc {
  font-size: 21rpx;
  color: var(--text-muted);
  margin: 8rpx 0 14rpx;
  line-height: 1.5;
}

.sub-action-grid {
  display: flex;
  gap: 12rpx;
}

.btn-sub {
  flex: 1;
  background-color: #1e293b;
  color: var(--text-primary);
  border: 1px solid var(--border-subtle);
  font-size: 22rpx;
  border-radius: 12rpx;
}

.btn-confirm {
  width: 100%;
  margin-top: 20rpx;
  background-color: #0284c7;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: bold;
  border-radius: 18rpx;
  height: 84rpx;
  line-height: 84rpx;
}

/* 识图验真中心 */
.verify-channel-row {
  display: flex;
  gap: 14rpx;
  margin-bottom: 18rpx;
}

.verify-ch-btn {
  flex: 1;
  text-align: center;
  padding: 18rpx 10rpx;
  border-radius: 16rpx;
  font-size: 24rpx;
  font-weight: bold;
  color: #ffffff;
}

.verify-ch-btn.primary { background-color: #0284c7; }
.verify-ch-btn.emerald { background-color: #059669; }

.verify-seal-banner {
  border-radius: 18rpx;
  padding: 18rpx;
  margin-bottom: 16rpx;
  border: 1px solid var(--border-subtle);
  background-color: rgba(30, 41, 59, 0.72);
}

.verify-seal-banner.VERIFIED {
  border-color: var(--accent-emerald);
  background-color: rgba(5, 150, 105, 0.22);
}

.verify-seal-banner.TAMPERED {
  border-color: var(--accent-danger);
  background-color: rgba(220, 38, 38, 0.22);
}

.seal-badge-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.seal-badge-tag {
  font-size: 24rpx;
  font-weight: bold;
  color: var(--text-primary);
}

.seal-source-tag {
  font-size: 20rpx;
  color: var(--text-muted);
}

.seal-main-title {
  font-size: 27rpx;
  font-weight: bold;
  margin-top: 8rpx;
}

.seal-desc {
  font-size: 21rpx;
  color: var(--text-secondary);
  margin-top: 6rpx;
  line-height: 1.5;
}

.verify-detail-box {
  background-color: rgba(15, 23, 42, 0.9);
  border-radius: 16rpx;
  padding: 16rpx;
}

.verify-img-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 14rpx;
}

.verify-thumb-img {
  width: 112rpx;
  height: 112rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
}

.verify-img-meta {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.v-meta-poi {
  font-size: 25rpx;
  font-weight: bold;
}

.v-meta-ts,
.v-meta-ntp {
  font-size: 20rpx;
  color: var(--text-muted);
  margin-top: 4rpx;
}

.v-kv-row {
  display: flex;
  justify-content: space-between;
  padding: 8rpx 0;
  border-top: 1px solid rgba(148, 163, 184, 0.14);
  font-size: 21rpx;
}

.v-k { color: var(--text-muted); }
.v-v { color: var(--text-primary); text-align: right; max-width: 65%; word-break: break-all; }

.action-grid-two {
  display: flex;
  gap: 14rpx;
}

.btn-primary-nav.half,
.btn-share-friend.half {
  flex: 1;
  font-size: 24rpx;
  font-weight: bold;
  color: #ffffff;
  border-radius: 16rpx;
  height: 76rpx;
  line-height: 76rpx;
}

.btn-primary-nav.half { background-color: #0284c7; }
.btn-share-friend.half { background-color: #059669; }

.verify-empty-guide {
  background-color: rgba(30, 41, 59, 0.55);
  border-radius: 16rpx;
  padding: 18rpx;
}

.v-guide-title {
  font-size: 24rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.v-guide-item {
  font-size: 21rpx;
  color: var(--text-secondary);
  line-height: 1.6;
  margin-bottom: 8rpx;
}

.v-manual-row {
  display: flex;
  gap: 10rpx;
  margin-top: 12rpx;
}

.v-manual-input {
  flex: 1;
}

.v-manual-btn {
  padding: 0 26rpx;
  height: 76rpx;
