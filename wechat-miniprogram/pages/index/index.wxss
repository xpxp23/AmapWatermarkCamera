.page-root {
  width: 100vw;
  height: 100vh;
  background-color: #000000;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

/* 1. 顶部工具栏：左置紧凑排列，严格预留右侧 206rpx 避让微信官方胶囊按钮 */
.top-bar {
  background-color: #000000;
  padding-left: 26rpx;
  padding-right: 206rpx;
  padding-bottom: 14rpx;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  z-index: 20;
}

.top-left-group {
  display: flex;
  align-items: center;
  gap: 28rpx;
}

.top-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.top-icon {
  font-size: 32rpx;
  color: #ffffff;
}

.top-label {
  font-size: 20rpx;
  color: #cbd5e1;
  margin-top: 4rpx;
}

.accent {
  color: #38bdf8;
}

.emerald {
  color: #34d399;
}

/* 2. 中央取景器 */
.viewfinder-wrap {
  flex: 1;
  width: 100%;
  position: relative;
  overflow: hidden;
  background-color: #0a0e17;
}

.camera-view {
  width: 100%;
  height: 100%;
}

.camera-paused-backdrop {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #090d16;
}

.paused-tip {
  font-size: 24rpx;
  color: #64748b;
}

/* 顶部 GPS 状态胶囊 */
.gps-pill {
  position: absolute;
  top: 22rpx;
  left: 22rpx;
  background-color: rgba(11, 19, 43, 0.85);
  border: 1px solid rgba(56, 189, 248, 0.45);
  border-radius: 32rpx;
  padding: 10rpx 22rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
}

.gps-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 7rpx;
  margin-right: 12rpx;
  background-color: #34d399;
}

.gps-dot.searching {
  background-color: #fbbf24;
}

.gps-dot.manual {
  background-color: #f59e0b;
}

.gps-pill-text {
  font-size: 21rpx;
  color: #ffffff;
}

/* 左右滑动切换模板悬浮提示 */
.swipe-toast-pill {
  position: absolute;
  top: 86rpx;
  left: 22rpx;
  background-color: rgba(15, 23, 42, 0.90);
  border: 1px solid #38bdf8;
  border-radius: 26rpx;
  padding: 8rpx 20rpx;
}

.swipe-toast-txt {
  font-size: 21rpx;
  font-weight: bold;
  color: #38bdf8;
}

/* 好友分享位置 & 防伪核验横幅 */
.shared-jump-banner {
  position: absolute;
  top: 94rpx;
  left: 22rpx;
  right: 22rpx;
  background-color: rgba(15, 23, 42, 0.95);
  border: 2rpx solid #38bdf8;
  border-radius: 24rpx;
  padding: 24rpx;
}

.shared-banner-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #ffffff;
}

.shared-banner-coord {
  font-size: 23rpx;
  color: #38bdf8;
  margin-top: 8rpx;
}

.shared-banner-verify {
  font-size: 21rpx;
  margin-top: 8rpx;
  padding: 6rpx 12rpx;
  border-radius: 10rpx;
}

.shared-banner-verify.ok {
  background-color: rgba(5, 150, 105, 0.25);
  color: #34d399;
}

.shared-banner-verify.warn {
  background-color: rgba(217, 119, 6, 0.25);
  color: #fbbf24;
}

.shared-banner-actions {
  display: flex;
  flex-direction: row;
  margin-top: 18rpx;
  gap: 16rpx;
}

.shared-btn-nav {
  flex: 1;
  background-color: #059669;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: bold;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 16rpx;
}

.shared-btn-close {
  width: 120rpx;
  background-color: #334155;
  color: #cbd5e1;
  font-size: 24rpx;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 16rpx;
}

/* ==================== 模板 0/1/2/4 悬浮水印容器 ==================== */
.live-wm-container {
  position: absolute;
  left: 20rpx;
  right: 20rpx;
  bottom: 20rpx;
  display: flex;
  flex-direction: row;
  align-items: flex-end;
  justify-content: space-between;
}

/* 模板 0: 经典大字时间 */
.wm-tpl-0 {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  overflow: hidden;
}

.wm-tpl-0.with-qr {
  margin-right: 16rpx;
}

.wm-big-time {
  font-size: 80rpx;
  font-weight: 300;
  color: #ffffff;
}

.wm-sub-line {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  margin-top: 6rpx;
  max-width: 100%;
}

.wm-date-text {
  font-size: 24rpx;
  color: #ffffff;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.wm-poi-text {
  font-size: 24rpx;
  color: #ffffff;
  font-weight: bold;
  max-width: 300rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.wm-addr-line {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #cbd5e1;
  max-width: 96%;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.wm-coord-pill {
  margin-top: 10rpx;
  background-color: rgba(11, 19, 43, 0.84);
  border: 1px solid rgba(56, 189, 248, 0.50);
  border-radius: 28rpx;
  padding: 6rpx 18rpx;
  font-size: 20rpx;
  color: #38bdf8;
  max-width: 98%;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.wm-coord-pill.dms-compact {
  font-size: 17.5rpx;
  padding: 6rpx 14rpx;
}

.wm-env-text {
  margin-top: 6rpx;
  font-size: 19.5rpx;
  color: #a7f3d0;
}

.wm-note-text {
  margin-top: 6rpx;
  font-size: 20.5rpx;
  color: #fde68a;
  max-width: 96%;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.wm-verify-line {
  margin-top: 6rpx;
  font-size: 18.5rpx;
  color: #34d399;
}

/* 模板 1: 工程巡检卡片 */
.wm-tpl-card {
  flex: 1;
  background-color: rgba(11, 19, 43, 0.85);
  border: 1px solid rgba(56, 189, 248, 0.48);
  border-radius: 20rpx;
  padding: 16rpx 18rpx;
  margin-right: 14rpx;
  overflow: hidden;
}

.wm-card-header-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-bottom: 8rpx;
  padding-bottom: 8rpx;
  border-bottom: 1px solid rgba(255, 255, 255, 0.14);
}

.wm-accent-bar {
  width: 8rpx;
  height: 26rpx;
  background-color: #38bdf8;
  border-radius: 4rpx;
  margin-right: 12rpx;
}

.wm-card-header {
  flex: 1;
  font-size: 24rpx;
  font-weight: bold;
  color: #ffffff;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.wm-card-tag {
  font-size: 18rpx;
  color: #38bdf8;
  background-color: rgba(56, 189, 248, 0.16);
  padding: 4rpx 10rpx;
  border-radius: 8rpx;
  margin-left: 8rpx;
}

.wm-card-tag.verify {
  color: #34d399;
  background-color: rgba(16, 185, 129, 0.22);
}

.wm-card-lines {
  width: 100%;
  overflow: hidden;
}

.wm-card-row {
  font-size: 20rpx;
  color: #ffffff;
  margin-top: 6rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.wm-card-row.dms-compact {
  font-size: 18rpx;
}

.wm-card-row.muted {
  color: #cbd5e1;
  font-size: 19rpx;
}

.wm-card-row.emerald {
  color: #34d399;
}

.wm-card-row.amber {
  color: #fde68a;
}

/* 模板 2: 经纬网格测绘 */
.wm-tpl-grid {
  flex: 1;
  background-color: rgba(9, 14, 26, 0.88);
  border: 1px solid rgba(56, 189, 248, 0.58);
  border-radius: 18rpx;
  margin-right: 14rpx;
  overflow: hidden;
}

.wm-grid-top {
  background-color: rgba(56, 189, 248, 0.20);
  color: #38bdf8;
  font-size: 20rpx;
  font-weight: bold;
  padding: 10rpx 14rpx;
  border-bottom: 1px solid rgba(148, 163, 184, 0.28);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.wm-grid-top.dms-compact {
  font-size: 17.5rpx;
}

.wm-grid-cells {
  display: flex;
  flex-direction: row;
  align-items: center;
  border-bottom: 1px solid rgba(148, 163, 184, 0.28);
}

.wm-grid-cell {
  flex: 1;
  padding: 10rpx 14rpx;
  overflow: hidden;
}

.wm-grid-cell.left {
  border-right: 1px solid rgba(148, 163, 184, 0.28);
}

.wm-grid-label {
  font-size: 17.5rpx;
  color: #94a3b8;
}

.wm-grid-val {
  font-size: 21rpx;
  font-weight: bold;
  color: #ffffff;
  margin-top: 4rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.wm-grid-val.mono {
  font-size: 19rpx;
}

.wm-grid-footer {
  padding: 8rpx 14rpx;
  font-size: 18.5rpx;
  color: #fde68a;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* ==================== 模板 3: 极简胶片底栏 (独立全宽双层通栏，零截断零重复) ==================== */
.film-bar-wrapper {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.film-floating-qr {
  margin-right: 20rpx;
  margin-bottom: 14rpx;
}

.wm-tpl-film-full {
  width: 100%;
  background-color: rgba(8, 12, 20, 0.92);
  border-top: 3rpx solid #38bdf8;
  padding: 14rpx 24rpx 16rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.wm-film-row-top {
  width: 100%;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.wm-film-poi {
  font-size: 25rpx;
  font-weight: bold;
  color: #ffffff;
  max-width: 48%;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.wm-film-time {
  font-size: 20rpx;
  color: #e2e8f0;
  white-space: nowrap;
}

.wm-film-row-bottom {
  width: 100%;
  margin-top: 8rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.wm-film-coord-full {
  font-size: 20rpx;
  font-weight: bold;
  color: #38bdf8;
  flex: 1;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.wm-film-badge {
  font-size: 18.5rpx;
  margin-left: 16rpx;
  max-width: 38%;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.wm-film-badge.emerald {
  color: #34d399;
}

.wm-film-badge.amber {
  color: #fde68a;
}

.wm-film-badge.muted {
  color: #94a3b8;
}

/* 模板 4: 外业标准台账 */
.wm-tpl-ledger {
  flex: 1;
  background-color: rgba(11, 19, 43, 0.88);
  border: 2rpx solid #38bdf8;
  border-radius: 16rpx;
  margin-right: 14rpx;
  overflow: hidden;
}

.wm-ledger-header {
  background-color: rgba(56, 189, 248, 0.24);
  color: #ffffff;
  font-size: 21.5rpx;
  font-weight: bold;
  padding: 10rpx 14rpx;
  border-bottom: 1px solid rgba(56, 189, 248, 0.48);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.wm-ledger-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  border-bottom: 1px solid rgba(148, 163, 184, 0.22);
}

.wm-ledger-k {
  width: 112rpx;
  padding: 8rpx 10rpx;
  font-size: 18.5rpx;
  font-weight: bold;
  color: #38bdf8;
  border-right: 1px solid rgba(148, 163, 184, 0.25);
  flex-shrink: 0;
}

.wm-ledger-v {
  flex: 1;
  padding: 8rpx 12rpx;
  font-size: 19rpx;
  color: #ffffff;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.wm-ledger-v.dms-compact {
  font-size: 17rpx;
}

.wm-ledger-v.amber {
  color: #fde68a;
}

.wm-ledger-v.emerald {
  color: #34d399;
}

/* 右下角二维码预览角标 */
.wm-qr-preview-badge {
  width: 120rpx;
  background-color: rgba(11, 19, 43, 0.90);
  border: 1px solid rgba(56, 189, 248, 0.55);
  border-radius: 16rpx;
  padding: 10rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
}

.wm-qr-box {
  width: 90rpx;
  height: 90rpx;
  background-color: #ffffff;
  border-radius: 8rpx;
  position: relative;
}

.wm-qr-finder {
  width: 22rpx;
  height: 22rpx;
  border: 4rpx solid #0b132b;
  position: absolute;
  box-sizing: border-box;
}

.wm-qr-finder.tl {
  top: 8rpx;
  left: 8rpx;
}

.wm-qr-finder.tr {
  top: 8rpx;
  right: 8rpx;
}

.wm-qr-finder.bl {
  bottom: 8rpx;
  left: 8rpx;
}

.wm-qr-center-dot {
  position: absolute;
  left: 18rpx;
  right: 18rpx;
  top: 31rpx;
  background-color: #0284c7;
  color: #ffffff;
  font-size: 16rpx;
  font-weight: bold;
  text-align: center;
  border-radius: 4rpx;
  padding: 2rpx 0;
}

.wm-qr-txt {
  font-size: 17.5rpx;
  color: #38bdf8;
  margin-top: 6rpx;
  font-weight: bold;
}

/* 5款模板快切栏 */
.tpl-bar {
  display: flex;
  flex-direction: row;
  background-color: #060911;
  padding: 12rpx 16rpx;
  gap: 10rpx;
}

.tpl-pill {
  flex: 1;
  text-align: center;
  font-size: 22rpx;
  padding: 10rpx 0;
  border-radius: 24rpx;
  background-color: #141d2e;
  color: #94a3b8;
}

.tpl-pill.active {
  background-color: #0284c7;
  color: #ffffff;
  font-weight: bold;
}

/* 3. 底部主控栏 */
.bottom-bar {
  height: 196rpx;
  background-color: #000000;
  padding: 0 36rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.bot-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.bot-icon {
  font-size: 42rpx;
}

.bot-label {
  font-size: 21rpx;
  color: #ffffff;
  margin-top: 6rpx;
}

.thumb-circle {
  width: 78rpx;
  height: 78rpx;
  border-radius: 39rpx;
  border: 3rpx solid #ffffff;
}

.thumb-placeholder {
  width: 78rpx;
  height: 78rpx;
  border-radius: 39rpx;
  border: 3rpx solid #475569;
  background-color: #1e293b;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
}

.shutter-outer {
  width: 136rpx;
  height: 136rpx;
  border-radius: 68rpx;
  border: 8rpx solid #ffffff;
  padding: 10rpx;
  box-sizing: border-box;
}

.shutter-outer.optical {
  border-color: #38bdf8;
}

.shutter-inner {
  width: 100%;
  height: 100%;
  border-radius: 58rpx;
  background-color: rgba(255, 255, 255, 0.28);
}

/* ==================== 弹窗与相册样式 ==================== */
.modal-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.86);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.gallery-sheet {
  width: 100vw;
  height: 100vh;
  background-color: #090d16;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.sheet-header {
  padding-left: 24rpx;
  padding-right: 204rpx;
  padding-bottom: 20rpx;
  background-color: #000000;
  border-bottom: 1px solid #1e293b;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.sheet-header-left {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
}

.sheet-back-pill {
  background-color: #1e293b;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: bold;
  padding: 10rpx 20rpx;
  border-radius: 28rpx;
}

.sheet-title {
  color: #ffffff;
  font-size: 26rpx;
  font-weight: bold;
}

.sheet-action-left {
  background-color: #0284c7;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: bold;
  padding: 10rpx 18rpx;
  border-radius: 24rpx;
}

.gallery-empty-state {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
}

.empty-icon {
  font-size: 96rpx;
  margin-bottom: 24rpx;
}

.empty-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #ffffff;
  margin-bottom: 16rpx;
}

.empty-desc {
  font-size: 24rpx;
  color: #94a3b8;
  text-align: center;
  line-height: 1.6;
  margin-bottom: 40rpx;
}

.empty-btn-row {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.gallery-preview-box {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx;
  overflow: hidden;
}

.gallery-main-img {
  width: 100%;
  height: 100%;
}

.gallery-thumb-strip {
  height: 120rpx;
  background-color: #050811;
  border-top: 1px solid #1e293b;
  white-space: nowrap;
  padding: 14rpx 24rpx;
  box-sizing: border-box;
}

.thumb-item {
  display: inline-block;
  width: 90rpx;
  height: 90rpx;
  border-radius: 14rpx;
  margin-right: 16rpx;
  overflow: hidden;
  border: 3rpx solid #334155;
  vertical-align: middle;
}

.thumb-item.selected {
  border-color: #38bdf8;
}

.thumb-item-img {
  width: 100%;
  height: 100%;
}

.gallery-info-panel {
  background-color: #0f172a;
  padding: 22rpx 28rpx 34rpx;
  border-top: 1px solid #1e293b;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.info-text-col {
  flex: 1;
  margin-right: 16rpx;
  overflow: hidden;
}

.info-poi {
  font-size: 28rpx;
  font-weight: bold;
  color: #ffffff;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.info-sys-badge {
  font-size: 20rpx;
  color: #38bdf8;
  margin-left: 8rpx;
}

.info-gcj {
  font-size: 22rpx;
  color: #38bdf8;
  margin-top: 4rpx;
}

.info-wgs {
  font-size: 20rpx;
  color: #94a3b8;
}

.info-verify {
  font-size: 20rpx;
  color: #34d399;
  margin-top: 4rpx;
}

.copy-btn {
  background-color: #1e293b;
  color: #38bdf8;
  border: 1px solid #334155;
}

.action-grid {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.btn-primary-nav {
  width: 100% !important;
  background-color: #2563eb;
  color: #ffffff;
  font-size: 25rpx;
  font-weight: bold;
  border-radius: 18rpx;
}

.btn-share-friend {
  width: 100% !important;
  background-color: #059669;
  color: #ffffff;
  font-size: 25rpx;
  font-weight: bold;
  border-radius: 18rpx;
}

.sub-action-grid {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  margin-top: 14rpx;
  gap: 12rpx;
}

.btn-sub {
  flex: 1;
  background-color: #1e293b;
  color: #e2e8f0;
  font-size: 21rpx;
  padding: 0 8rpx !important;
}

.btn-sub.highlight {
  color: #fde68a;
  border: 1px solid rgba(251, 191, 36, 0.45);
}

.btn-sub.relocate-btn {
  color: #38bdf8;
  border: 1px solid rgba(56, 189, 248, 0.45);
}

.btn-sub.danger {
  color: #f87171;
}

/* ==================== 弹窗卡片与双模式地点校准 UI ==================== */
.dialog-card {
  width: 90vw;
  max-height: 86vh;
  overflow-y: auto;
  background-color: #0f172a;
  border: 1px solid #334155;
  border-radius: 28rpx;
  padding: 30rpx;
}

.dialog-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #ffffff;
  margin-bottom: 18rpx;
}

/* 坐标源状态横幅 */
.coord-source-banner {
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  border: 1px solid #334155;
  background-color: #090d16;
}

.coord-source-banner.real {
  border-color: rgba(52, 211, 153, 0.45);
  background-color: rgba(5, 150, 105, 0.12);
}

.coord-source-banner.manual {
  border-color: rgba(245, 158, 11, 0.55);
  background-color: rgba(217, 119, 6, 0.14);
}

.source-row {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 6rpx;
}

.source-tag {
  font-size: 22rpx;
  font-weight: bold;
  color: #ffffff;
}

.source-restore-btn {
  font-size: 21rpx;
  font-weight: bold;
  color: #38bdf8;
  background-color: rgba(2, 132, 199, 0.22);
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
}

.source-coord-line {
  font-size: 20rpx;
  color: #38bdf8;
}

.source-coord-line.sub {
  font-size: 19rpx;
  color: #94a3b8;
  margin-top: 2rpx;
}

/* 🏷 地图选名胶囊按钮 (仅改名不改坐标) */
.label-with-action {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.btn-pick-name-only {
  background-color: rgba(16, 185, 129, 0.20);
  border: 1px solid #34d399;
  color: #34d399;
  font-size: 20rpx;
  font-weight: bold;
  padding: 6rpx 16rpx;
  border-radius: 24rpx;
}

.helper-hint {
  font-size: 19.5rpx;
  color: #94a3b8;
  line-height: 1.45;
  margin-top: 8rpx;
}

/* 📌 地图选点改坐标独立盒 */
.map-relocate-box {
  background-color: #090d16;
  border: 1px solid #1e293b;
  border-radius: 18rpx;
  padding: 18rpx;
  margin-top: 12rpx;
}

.relocate-header {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 6rpx;
}

.relocate-title {
  font-size: 22rpx;
  font-weight: bold;
  color: #e2e8f0;
}

.relocate-lock-badge {
  font-size: 19rpx;
  color: #34d399;
  background-color: rgba(16, 185, 129, 0.18);
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
}

.relocate-desc {
  font-size: 19.5rpx;
  color: #64748b;
  line-height: 1.4;
}

/* 三坐标系三选一分段器 */
.coord-sys-selector {
  display: flex;
  flex-direction: row;
  gap: 12rpx;
}

.coord-sys-pill {
  flex: 1;
  background-color: #1e293b;
  border: 1px solid #334155;
  border-radius: 16rpx;
  padding: 14rpx 8rpx;
  text-align: center;
}

.coord-sys-pill.selected {
  background-color: #0284c7;
  border-color: #38bdf8;
}

.sys-name {
  font-size: 23rpx;
  font-weight: bold;
  color: #ffffff;
}

.sys-desc {
  font-size: 18rpx;
  color: #cbd5e1;
  margin-top: 4rpx;
}

/* 外观深度定制行 (颜色圆点 + 字号 + 透明度) */
.custom-appearance-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: 10rpx;
  margin-bottom: 10rpx;
}

.color-dots-group {
  display: flex;
  flex-direction: row;
  gap: 12rpx;
}

.color-dot {
  width: 40rpx;
  height: 40rpx;
  border-radius: 20rpx;
  border: 2rpx solid transparent;
}

.color-dot.selected {
  border: 4rpx solid #ffffff;
}

.scale-pills-group {
  display: flex;
  flex-direction: row;
  background-color: #090d16;
  border-radius: 14rpx;
  padding: 4rpx;
  border: 1px solid #1e293b;
}

.mini-opt {
  font-size: 19rpx;
  color: #94a3b8;
  padding: 6rpx 12rpx;
  border-radius: 10rpx;
}

.mini-opt.selected {
  background-color: #0284c7;
  color: #ffffff;
  font-weight: bold;
}

/* 要素开关双列矩阵 */
.toggle-matrix {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 8rpx;
}

.matrix-chip {
  width: calc(50% - 8rpx);
  box-sizing: border-box;
  background-color: #1e293b;
  border: 1px solid #334155;
  color: #94a3b8;
  font-size: 21rpx;
  padding: 12rpx 14rpx;
  border-radius: 14rpx;
  text-align: center;
}

.matrix-chip.on {
  background-color: rgba(2, 132, 199, 0.28);
  border-color: #38bdf8;
  color: #ffffff;
  font-weight: bold;
}

.setting-section-label {
  font-size: 22rpx;
  font-weight: bold;
  color: #38bdf8;
  margin-bottom: 10rpx;
}

.chip-wrap {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 10rpx;
  margin-bottom: 14rpx;
}

.quick-chip {
  background-color: #1e293b;
  border: 1px solid #334155;
  color: #cbd5e1;
  font-size: 20.5rpx;
  padding: 8rpx 18rpx;
  border-radius: 24rpx;
}

.quick-chip.active {
  background-color: #0284c7;
  border-color: #38bdf8;
  color: #ffffff;
  font-weight: bold;
}

.quick-chip.clear {
  color: #f87171;
  border-color: rgba(248, 113, 113, 0.45);
}

.mode-switch-row {
  display: flex;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.mode-option {
  flex: 1;
  padding: 14rpx 8rpx;
  text-align: center;
  font-size: 21.5rpx;
  border-radius: 14rpx;
  background-color: #1e293b;
  color: #94a3b8;
  border: 1px solid #334155;
}

.mode-option.selected {
  background-color: #0284c7;
  color: #ffffff;
  font-weight: bold;
  border-color: #38bdf8;
}

.switch-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10rpx 0;
  font-size: 23.5rpx;
  color: #ffffff;
}

.switch-row.compact {
  padding: 4rpx 0 8rpx;
}

.input-label-inline {
  font-size: 22rpx;
  color: #cbd5e1;
}

.input-group {
  margin-bottom: 16rpx;
}

.input-label {
  font-size: 21.5rpx;
  color: #94a3b8;
}

.text-input {
  background-color: #020617;
  border: 1px solid #334155;
  border-radius: 14rpx;
  padding: 12rpx 18rpx;
  color: #ffffff;
  font-size: 24.5rpx;
}

.btn-confirm {
  margin-top: 20rpx;
  background-color: #2563eb;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: bold;
  border-radius: 18rpx;
}
