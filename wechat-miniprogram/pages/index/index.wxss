.page-root {
  width: 100vw;
  height: 100vh;
  background-color: #000000;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  overflow: hidden;
}

/* 1. 顶部工具栏：精准对齐微信右上角官方胶囊按钮 */
.top-bar {
  background-color: #000000;
  padding-left: 20rpx;
  padding-bottom: 12rpx;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  z-index: 20;
  box-sizing: content-box;
}

.top-left-group {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.top-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.top-icon-pill {
  min-width: 48rpx;
  height: 44rpx;
  padding: 0 8rpx;
  border-radius: 22rpx;
  background-color: rgba(30, 41, 59, 0.78);
  border: 1px solid rgba(148, 163, 184, 0.22);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: #ffffff;
}

.top-icon-pill.accent {
  border-color: rgba(56, 189, 248, 0.55);
  background-color: rgba(2, 132, 199, 0.25);
  color: #38bdf8;
}

.top-icon-pill.emerald {
  border-color: rgba(52, 211, 153, 0.55);
  background-color: rgba(5, 150, 105, 0.25);
  color: #34d399;
}

.top-icon-pill.amber {
  border-color: rgba(251, 191, 36, 0.55);
  background-color: rgba(217, 119, 6, 0.25);
  color: #fbbf24;
}

.top-label {
  font-size: 19rpx;
  color: #cbd5e1;
  margin-top: 4rpx;
}

.accent {
  color: #38bdf8 !important;
}

.emerald {
  color: #34d399 !important;
}

.amber {
  color: #fbbf24 !important;
}

.danger {
  color: #f87171 !important;
}

/* 2. 中央取景器 */
.viewfinder-wrap {
  flex: 1;
  width: 100%;
  position: relative;
  overflow: hidden;
  background-color: #0a0e17;
}

.camera-view {
  width: 100%;
  height: 100%;
  position: absolute;
  left: 0;
  top: 0;
  z-index: 1;
}

.viewfinder-hud-layer {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 5;
  pointer-events: auto;
}

/* 相机冷启动毛玻璃过渡动画 (消除2~3秒黑屏体感) */
.camera-boot-overlay {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: radial-gradient(circle at center, #111c35 0%, #070b14 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 15;
}

.boot-lens-ring {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  border: 4rpx solid rgba(56, 189, 248, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

.boot-lens-core {
  width: 56rpx;
  height: 56rpx;
  border-radius: 28rpx;
  background-color: rgba(56, 189, 248, 0.35);
}

.boot-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #f8fafc;
}

.boot-sub {
  font-size: 21rpx;
  color: #64748b;
  margin-top: 8rpx;
}

/* 九宫格辅助线 */
.grid-lines-overlay {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  pointer-events: none;
}

.grid-v {
  position: absolute;
  top: 0;
  bottom: 0;
  width: 1px;
  background-color: rgba(255, 255, 255, 0.24);
}
.grid-v.v1 { left: 33.33%; }
.grid-v.v2 { left: 66.66%; }

.grid-h {
  position: absolute;
  left: 0;
  right: 0;
  height: 1px;
  background-color: rgba(255, 255, 255, 0.24);
}
.grid-h.h1 { top: 33.33%; }
.grid-h.h2 { top: 66.66%; }

/* 顶部 GPS 状态胶囊 */
.gps-pill {
  position: absolute;
  top: 20rpx;
  left: 20rpx;
  background-color: rgba(11, 19, 43, 0.85);
  border: 1px solid rgba(56, 189, 248, 0.45);
  border-radius: 32rpx;
  padding: 8rpx 20rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  z-index: 10;
}

.gps-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 7rpx;
  margin-right: 12rpx;
  background-color: #34d399;
}

.gps-dot.searching {
  background-color: #fbbf24;
}

.gps-dot.manual {
  background-color: #f59e0b;
}

.gps-pill-text {
  font-size: 21rpx;
  color: #ffffff;
}

/* 160x160 高德矢量缩略图组件 (左上角独立悬浮 & 卡片内嵌双形态) */
.floating-minimap-box {
  position: absolute;
  top: 84rpx;
  left: 20rpx;
  width: 156rpx;
  height: 156rpx;
  background-color: rgba(12, 22, 41, 0.92);
  border: 2rpx solid #38bdf8;
  border-radius: 18rpx;
  overflow: hidden;
  z-index: 9;
}

.embedded-minimap-box {
  width: 136rpx;
  height: 136rpx;
  background-color: rgba(12, 22, 41, 0.94);
  border: 2rpx solid #38bdf8;
  border-radius: 14rpx;
  margin-right: 14rpx;
  position: relative;
  overflow: hidden;
  flex-shrink: 0;
}

.embedded-minimap-box.small {
  width: 96rpx;
  height: 82rpx;
  margin: 6rpx 0 6rpx 10rpx;
}

.minimap-north-tag {
  position: absolute;
  top: 6rpx;
  left: 6rpx;
  background-color: rgba(15, 23, 42, 0.86);
  color: #38bdf8;
  font-size: 15rpx;
  font-weight: bold;
  padding: 2rpx 8rpx;
  border-radius: 6rpx;
  z-index: 3;
}

.minimap-road-h {
  position: absolute;
  left: 0;
  right: 0;
  top: 48%;
  height: 6rpx;
  background-color: rgba(245, 158, 11, 0.55);
  transform: rotate(-8deg);
}

.minimap-road-v {
  position: absolute;
  top: 0;
  bottom: 0;
  left: 52%;
  width: 5rpx;
  background-color: rgba(148, 163, 184, 0.42);
  transform: rotate(6deg);
}

.minimap-radar-circle {
  position: absolute;
  left: 50%;
  top: 46%;
  width: 56rpx;
  height: 56rpx;
  margin-left: -28rpx;
  margin-top: -28rpx;
  border-radius: 28rpx;
  background-color: rgba(56, 189, 248, 0.18);
  border: 1px solid rgba(56, 189, 248, 0.65);
  display: flex;
  align-items: center;
  justify-content: center;
}

.minimap-center-pin {
  width: 14rpx;
  height: 14rpx;
  border-radius: 7rpx;
  background-color: #ef4444;
  border: 2rpx solid #ffffff;
}

.minimap-poi-bar {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 28rpx;
  line-height: 28rpx;
  background-color: rgba(11, 19, 43, 0.90);
  color: #e2e8f0;
  font-size: 16rpx;
  text-align: center;
  padding: 0 6rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 右侧变焦按钮 */
.zoom-floating-btn {
  position: absolute;
  right: 22rpx;
  top: 44%;
  width: 72rpx;
  height: 72rpx;
  border-radius: 36rpx;
  background-color: rgba(11, 19, 43, 0.72);
  border: 2rpx solid rgba(255, 255, 255, 0.85);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
}

.zoom-txt {
  color: #ffffff;
  font-size: 21rpx;
  font-weight: bold;
}

/* 倒计时与闪白遮罩 */
.countdown-overlay {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 16;
  pointer-events: none;
}

.countdown-num {
  font-size: 160rpx;
  font-weight: bold;
  color: #ffffff;
  text-shadow: 0 6rpx 24rpx rgba(0, 0, 0, 0.85);
}

.shutter-flash-mask {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(255, 255, 255, 0.85);
  z-index: 18;
  pointer-events: none;
}

/* 左右滑动切换模板悬浮提示 */
.swipe-toast-pill {
  position: absolute;
  top: 84rpx;
  left: 50%;
  transform: translateX(-50%);
  background-color: rgba(15, 23, 42, 0.92);
  border: 1px solid #38bdf8;
  border-radius: 28rpx;
  padding: 8rpx 24rpx;
  z-index: 12;
}

.swipe-toast-txt {
  font-size: 22rpx;
  font-weight: bold;
  color: #38bdf8;
}

/* 好友分享位置 & 防伪核验横幅 */
.shared-jump-banner {
  position: absolute;
  top: 90rpx;
  left: 22rpx;
  right: 22rpx;
  background-color: rgba(15, 23, 42, 0.96);
  border: 2rpx solid #38bdf8;
  border-radius: 24rpx;
  padding: 24rpx;
  z-index: 14;
}

.shared-banner-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #ffffff;
}

.shared-banner-coord {
  font-size: 23rpx;
  color: #38bdf8;
  margin-top: 8rpx;
}

.shared-banner-verify {
  font-size: 21rpx;
  margin-top: 8rpx;
  padding: 6rpx 12rpx;
  border-radius: 10rpx;
}

.shared-banner-verify.ok {
  background-color: rgba(5, 150, 105, 0.25);
  color: #34d399;
}

.shared-banner-verify.warn {
  background-color: rgba(217, 119, 6, 0.25);
  color: #fbbf24;
}

.shared-banner-actions {
  display: flex;
  flex-direction: row;
  margin-top: 18rpx;
  gap: 16rpx;
}

.shared-btn-nav {
  flex: 1;
  background-color: #059669;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: bold;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 16rpx;
}

.shared-btn-close {
  width: 120rpx;
  background-color: #334155;
  color: #cbd5e1;
  font-size: 24rpx;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 16rpx;
}

/* ==================== 模板 0/1/2/4 悬浮水印容器 ==================== */
.live-wm-container {
  position: absolute;
  left: 20rpx;
  right: 20rpx;
  bottom: 20rpx;
  display: flex;
  flex-direction: row;
  align-items: flex-end;
  justify-content: space-between;
  z-index: 8;
}

.live-wm-container.reverse-row {
  flex-direction: row-reverse;
}

/* 模板 0: 经典大字时间 */
.wm-tpl-0 {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  overflow: hidden;
}

.wm-tpl-0.with-qr {
  margin-right: 16rpx;
}

.wm-big-time {
  font-size: 80rpx;
  font-weight: 300;
  color: #ffffff;
  text-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.65);
}

.wm-sub-line {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  margin-top: 6rpx;
  max-width: 100%;
}

.wm-date-text {
  font-size: 24rpx;
  color: #ffffff;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.wm-poi-text {
  font-size: 24rpx;
  color: #ffffff;
  font-weight: bold;
  max-width: 300rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.wm-addr-line {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #cbd5e1;
  max-width: 96%;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.wm-coord-pill {
  margin-top: 10rpx;
  background-color: rgba(11, 19, 43, 0.84);
  border: 1px solid rgba(56, 189, 248, 0.50);
  border-radius: 28rpx;
  padding: 6rpx 18rpx;
  font-size: 20rpx;
  color: #38bdf8;
  max-width: 98%;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.wm-coord-pill.dms-compact {
  font-size: 17.5rpx;
  padding: 6rpx 14rpx;
}

.wm-env-text {
  margin-top: 6rpx;
  font-size: 19.5rpx;
  color: #a7f3d0;
}

.wm-note-text {
  margin-top: 6rpx;
  font-size: 20.5rpx;
  color: #fde68a;
  max-width: 96%;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.wm-verify-line {
  margin-top: 6rpx;
  font-size: 18.5rpx;
  color: #34d399;
}

/* 模板 1: 工程巡检卡片 */
.wm-tpl-card {
  flex: 1;
  background-color: rgba(11, 19, 43, 0.85);
  border: 1px solid rgba(56, 189, 248, 0.48);
  border-radius: 20rpx;
  padding: 16rpx 18rpx;
  margin-right: 14rpx;
  overflow: hidden;
}

.live-wm-container.reverse-row .wm-tpl-card,
.live-wm-container.reverse-row .wm-tpl-grid,
.live-wm-container.reverse-row .wm-tpl-ledger {
  margin-right: 0;
  margin-left: 14rpx;
}

.wm-card-header-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-bottom: 8rpx;
  padding-bottom: 8rpx;
  border-bottom: 1px solid rgba(255, 255, 255, 0.14);
}

.wm-card-body-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.wm-accent-bar {
  width: 8rpx;
  height: 26rpx;
  background-color: #38bdf8;
  border-radius: 4rpx;
  margin-right: 12rpx;
}

.wm-card-header {
  flex: 1;
  font-size: 24rpx;
  font-weight: bold;
  color: #ffffff;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.wm-card-tag {
  font-size: 18rpx;
  color: #38bdf8;
  background-color: rgba(56, 189, 248, 0.16);
  padding: 4rpx 10rpx;
  border-radius: 8rpx;
  margin-left: 8rpx;
}

.wm-card-tag.verify {
  color: #34d399;
  background-color: rgba(16, 185, 129, 0.22);
}

.wm-card-lines {
  flex: 1;
  overflow: hidden;
}

.wm-card-row {
  font-size: 20rpx;
  color: #ffffff;
  margin-top: 6rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.wm-card-row.dms-compact {
  font-size: 18rpx;
}

.wm-card-row.muted {
  color: #cbd5e1;
  font-size: 19rpx;
}

.wm-card-row.emerald {
  color: #34d399;
}

.wm-card-row.amber {
  color: #fde68a;
}

/* 模板 2: 经纬网格测绘 */
.wm-tpl-grid {
  flex: 1;
  background-color: rgba(9, 14, 26, 0.88);
  border: 1px solid rgba(56, 189, 248, 0.58);
  border-radius: 18rpx;
  margin-right: 14rpx;
  overflow: hidden;
}

.wm-grid-top {
  background-color: rgba(56, 189, 248, 0.20);
  color: #38bdf8;
  font-size: 20rpx;
  font-weight: bold;
  padding: 10rpx 14rpx;
  border-bottom: 1px solid rgba(148, 163, 184, 0.28);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.wm-grid-top.dms-compact {
  font-size: 17.5rpx;
}

.wm-grid-cells {
  display: flex;
  flex-direction: row;
  align-items: center;
  border-bottom: 1px solid rgba(148, 163, 184, 0.28);
}

.wm-grid-cell {
  flex: 1;
  padding: 10rpx 14rpx;
  overflow: hidden;
}

.wm-grid-cell.left {
  border-right: 1px solid rgba(148, 163, 184, 0.28);
}

.wm-grid-label {
  font-size: 17.5rpx;
  color: #94a3b8;
}

.wm-grid-val {
  font-size: 21rpx;
  font-weight: bold;
  color: #ffffff;
  margin-top: 4rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.wm-grid-val.mono {
  font-size: 19rpx;
}

.wm-grid-footer {
  padding: 8rpx 14rpx;
  font-size: 18.5rpx;
  color: #fde68a;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* ==================== 模板 3: 极简胶片底栏 ==================== */
.film-bar-wrapper {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  z-index: 8;
}

.film-floating-qr {
  margin-right: 20rpx;
  margin-bottom: 14rpx;
}

.wm-tpl-film-full {
  width: 100%;
  background-color: rgba(8, 12, 20, 0.92);
  border-top: 3rpx solid #38bdf8;
  padding: 14rpx 24rpx 16rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.wm-film-row-top {
  width: 100%;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.wm-film-poi {
  font-size: 25rpx;
  font-weight: bold;
  color: #ffffff;
  max-width: 48%;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.wm-film-time {
  font-size: 20rpx;
  color: #e2e8f0;
  white-space: nowrap;
}

.wm-film-row-bottom {
  width: 100%;
  margin-top: 8rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.wm-film-coord-full {
  font-size: 20rpx;
  font-weight: bold;
  color: #38bdf8;
  flex: 1;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.wm-film-badge {
  font-size: 18.5rpx;
  margin-left: 16rpx;
  max-width: 38%;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.wm-film-badge.emerald {
  color: #34d399;
}

.wm-film-badge.amber {
  color: #fde68a;
}

.wm-film-badge.muted {
  color: #94a3b8;
}

/* 模板 4: 外业标准台账 */
.wm-tpl-ledger {
  flex: 1;
  background-color: rgba(11, 19, 43, 0.88);
  border: 2rpx solid #38bdf8;
  border-radius: 16rpx;
  margin-right: 14rpx;
  overflow: hidden;
}

.wm-ledger-header {
  background-color: rgba(56, 189, 248, 0.24);
  color: #ffffff;
  font-size: 21.5rpx;
  font-weight: bold;
  padding: 10rpx 14rpx;
  border-bottom: 1px solid rgba(56, 189, 248, 0.48);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.wm-ledger-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  border-bottom: 1px solid rgba(148, 163, 184, 0.22);
}

.wm-ledger-k {
  width: 112rpx;
  padding: 8rpx 10rpx;
  font-size: 18.5rpx;
  font-weight: bold;
  color: #38bdf8;
  border-right: 1px solid rgba(148, 163, 184, 0.25);
  flex-shrink: 0;
}

.wm-ledger-v {
  flex: 1;
  padding: 8rpx 12rpx;
  font-size: 19rpx;
  color: #ffffff;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.wm-ledger-v.dms-compact {
  font-size: 17rpx;
}

.wm-ledger-v.amber {
  color: #fde68a;
}

.wm-ledger-v.emerald {
  color: #34d399;
}

/* 右下角二维码预览角标 */
.wm-qr-preview-badge {
  width: 120rpx;
  background-color: rgba(11, 19, 43, 0.90);
  border: 1px solid rgba(56, 189, 248, 0.55);
  border-radius: 16rpx;
  padding: 10rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
}

.wm-qr-box {
  width: 90rpx;
  height: 90rpx;
  background-color: #ffffff;
  border-radius: 8rpx;
  position: relative;
}

.wm-qr-finder {
  width: 22rpx;
  height: 22rpx;
  border: 4rpx solid #0b132b;
  position: absolute;
  box-sizing: border-box;
}

.wm-qr-finder.tl { top: 8rpx; left: 8rpx; }
.wm-qr-finder.tr { top: 8rpx; right: 8rpx; }
.wm-qr-finder.bl { bottom: 8rpx; left: 8rpx; }

.wm-qr-center-dot {
  position: absolute;
  left: 18rpx;
  right: 18rpx;
  top: 31rpx;
  background-color: #0284c7;
  color: #ffffff;
  font-size: 16rpx;
  font-weight: bold;
