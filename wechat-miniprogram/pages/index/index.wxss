  color: #94a3b8;
  padding: 6rpx 12rpx;
  border-radius: 10rpx;
}

.mini-opt.selected {
  background-color: #0284c7;
  color: #ffffff;
  font-weight: bold;
}

.toggle-matrix {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 8rpx;
}

.matrix-chip {
  width: calc(50% - 8rpx);
  box-sizing: border-box;
  background-color: #1e293b;
  border: 1px solid #334155;
  color: #94a3b8;
  font-size: 21rpx;
  padding: 12rpx 14rpx;
  border-radius: 14rpx;
  text-align: center;
}

.matrix-chip.on {
  background-color: rgba(2, 132, 199, 0.28);
  border-color: #38bdf8;
  color: #ffffff;
  font-weight: bold;
}

.setting-section-label {
  font-size: 22rpx;
  font-weight: bold;
  color: #38bdf8;
  margin-bottom: 10rpx;
}

.chip-wrap {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 10rpx;
  margin-bottom: 14rpx;
}

.quick-chip {
  background-color: #1e293b;
  border: 1px solid #334155;
  color: #cbd5e1;
  font-size: 20.5rpx;
  padding: 8rpx 18rpx;
  border-radius: 24rpx;
}

.quick-chip.active {
  background-color: #0284c7;
  border-color: #38bdf8;
  color: #ffffff;
  font-weight: bold;
}

.quick-chip.clear {
  color: #f87171;
  border-color: rgba(248, 113, 113, 0.45);
}

.mode-switch-row {
  display: flex;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.mode-option {
  flex: 1;
  padding: 14rpx 8rpx;
  text-align: center;
  font-size: 21.5rpx;
  border-radius: 14rpx;
  background-color: #1e293b;
  color: #94a3b8;
  border: 1px solid #334155;
}

.mode-option.selected {
  background-color: #0284c7;
  color: #ffffff;
  font-weight: bold;
  border-color: #38bdf8;
}

.switch-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10rpx 0;
  font-size: 23rpx;
  color: #ffffff;
}

.switch-row.compact {
  padding: 4rpx 0 8rpx;
}

.input-label-inline {
  font-size: 22rpx;
  color: #cbd5e1;
}

.input-group {
  margin-bottom: 16rpx;
}

.input-label {
  font-size: 21.5rpx;
  color: #94a3b8;
}

.text-input {
  background-color: #020617;
  border: 1px solid #334155;
  border-radius: 14rpx;
  padding: 12rpx 18rpx;
  color: #ffffff;
  font-size: 24rpx;
}

.btn-confirm {
  margin-top: 20rpx;
  background-color: #2563eb;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: bold;
  border-radius: 18rpx;
}
