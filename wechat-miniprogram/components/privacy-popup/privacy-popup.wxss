.privacy-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(15, 23, 42, 0.45);
  backdrop-filter: blur(8px);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
  padding: 48rpx;
}

.privacy-card {
  width: 100%;
  max-width: 600rpx;
  background: #ffffff;
  border: 1rpx solid #eaedf2;
  border-radius: 32rpx;
  padding: 42rpx 36rpx 34rpx;
  box-sizing: border-box;
  box-shadow: 0 18rpx 48rpx rgba(15, 23, 42, 0.14);
}

.privacy-title {
  font-size: 33rpx;
  font-weight: 700;
  color: #111827;
  text-align: center;
}

.privacy-desc {
  margin-top: 22rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: #4b5563;
}

.privacy-link {
  color: #2563eb;
  font-weight: 600;
}

.privacy-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 34rpx;
}

.privacy-btn {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  border-radius: 20rpx;
  font-size: 28rpx;
  font-weight: 600;
  padding: 0;
  margin: 0;
  border: none;
}

.privacy-btn::after {
  border: none;
}

.privacy-btn.cancel {
  background: #f1f5f9;
  color: #4b5563;
}

.privacy-btn.confirm {
  background: #2563eb;
  color: #ffffff;
}
