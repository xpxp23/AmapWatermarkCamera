.wm-overlay-root {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  pointer-events: none;
  z-index: 8;
}

.tpl0-bottom-scrim {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 360rpx;
  background: linear-gradient(to bottom, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 0.58) 100%);
  pointer-events: none;
  z-index: 1;
}

.mono {
  font-family: "JetBrains Mono", Menlo, Monaco, Consolas, monospace;
}

.emerald {
  color: #34d399 !important;
}

.amber {
  color: #fde68a !important;
}

.muted {
  color: #cbd5e1 !important;
}

/* 悬浮水印主容器 */
.live-wm-container {
  position: absolute;
  left: 20rpx;
  right: 20rpx;
  bottom: 20rpx;
  display: flex;
  flex-direction: row;
  align-items: flex-end;
  justify-content: space-between;
  pointer-events: auto;
  z-index: 3;
}

.live-wm-container.reverse-row {
  flex-direction: row-reverse;
}

/* 模板 0: 大字时间 (清晰文字投影，无需暗幕也清晰锐利) */
.wm-tpl-0 {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  overflow: hidden;
}

.wm-tpl-0.with-qr {
  margin-right: 16rpx;
}

.wm-big-time {
  font-size: 80rpx;
  font-weight: 300;
  color: #ffffff;
  text-shadow: 0 3rpx 12rpx rgba(0, 0, 0, 0.82);
}

.wm-sub-line {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  margin-top: 6rpx;
  max-width: 100%;
}

.wm-date-text,
.wm-poi-text {
  font-size: 24rpx;
  color: #ffffff;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.85);
}

.wm-date-text {
  margin-right: 12rpx;
  flex-shrink: 0;
}

.wm-poi-text {
  font-weight: bold;
  max-width: 300rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.wm-addr-line {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #e2e8f0;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.85);
  max-width: 96%;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.wm-coord-pill {
  margin-top: 10rpx;
  background-color: rgba(11, 19, 43, 0.84);
  border: 1px solid rgba(56, 189, 248, 0.50);
  border-radius: 28rpx;
  padding: 6rpx 18rpx;
  font-size: 20rpx;
  color: #38bdf8;
  max-width: 98%;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.wm-coord-pill.dms-compact {
  font-size: 17.5rpx;
  padding: 6rpx 14rpx;
}

.wm-env-text {
  margin-top: 6rpx;
  font-size: 19.5rpx;
  color: #a7f3d0;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.85);
}

.wm-note-text {
  margin-top: 6rpx;
  font-size: 20.5rpx;
  color: #fde68a;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.85);
  max-width: 96%;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.wm-verify-line {
  margin-top: 6rpx;
  font-size: 18.5rpx;
  color: #34d399;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.85);
}

/* 模板 1: 巡检卡片 */
.wm-tpl-card {
  flex: 1;
  background-color: rgba(11, 19, 43, 0.85);
  border: 1px solid rgba(56, 189, 248, 0.48);
  border-radius: 20rpx;
  padding: 16rpx 18rpx;
  margin-right: 14rpx;
  overflow: hidden;
}

.wm-card-header-row {
  display: flex;
  align-items: center;
  padding-bottom: 10rpx;
  margin-bottom: 10rpx;
  border-bottom: 1px solid rgba(255, 255, 255, 0.14);
}

.wm-accent-bar {
  width: 8rpx;
  height: 24rpx;
  border-radius: 4rpx;
  margin-right: 10rpx;
}

.wm-card-header {
  flex: 1;
  font-size: 24rpx;
  font-weight: bold;
  color: #ffffff;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.wm-card-tag {
  font-size: 18rpx;
  font-weight: bold;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  background-color: rgba(15, 23, 42, 0.72);
}

.wm-card-lines {
  flex: 1;
  min-width: 0;
}

.wm-card-row {
  font-size: 20rpx;
  color: #f1f5f9;
  line-height: 1.5;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.wm-card-row.dms-compact {
  font-size: 17.5rpx;
}

/* 模板 2: 网格测绘 */
.wm-tpl-grid {
  flex: 1;
  background-color: rgba(11, 19, 43, 0.85);
  border: 1px solid #38bdf8;
  border-radius: 16rpx;
  margin-right: 14rpx;
  overflow: hidden;
}

.wm-grid-top {
  background-color: rgba(56, 189, 248, 0.20);
  padding: 10rpx 14rpx;
  font-size: 20rpx;
  font-weight: bold;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.wm-grid-top.dms-compact {
  font-size: 17.5rpx;
}

.wm-grid-cells {
  display: flex;
  flex-direction: row;
  align-items: center;
  border-top: 1px solid rgba(148, 163, 184, 0.28);
}

.wm-grid-cell {
  flex: 1;
  padding: 10rpx 12rpx;
  min-width: 0;
}

.wm-grid-cell.right {
  border-left: 1px solid rgba(148, 163, 184, 0.28);
}

.wm-grid-label {
  font-size: 16.5rpx;
  color: #94a3b8;
}

.wm-grid-val {
  font-size: 20rpx;
  font-weight: bold;
  color: #ffffff;
  margin-top: 4rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.wm-grid-footer {
  border-top: 1px solid rgba(148, 163, 184, 0.28);
  padding: 8rpx 14rpx;
  font-size: 18rpx;
  color: #fde68a;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 模板 4: 标准台账 */
.wm-tpl-ledger {
  flex: 1;
  background-color: rgba(11, 19, 43, 0.86);
  border: 1px solid #38bdf8;
  border-radius: 14rpx;
  margin-right: 14rpx;
  overflow: hidden;
}

.wm-ledger-header {
  background-color: rgba(56, 189, 248, 0.24);
  padding: 10rpx 14rpx;
  font-size: 21rpx;
  font-weight: bold;
  color: #ffffff;
}

.wm-ledger-row {
  display: flex;
  flex-direction: row;
  border-top: 1px solid rgba(56, 189, 248, 0.35);
}

.wm-ledger-k {
  width: 112rpx;
  flex-shrink: 0;
  padding: 7rpx 10rpx;
  font-size: 18.5rpx;
  font-weight: bold;
  border-right: 1px solid rgba(56, 189, 248, 0.35);
}

.wm-ledger-v {
  flex: 1;
  min-width: 0;
  padding: 7rpx 12rpx;
  font-size: 19rpx;
  color: #ffffff;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.wm-ledger-v.dms-compact {
  font-size: 17rpx;
}

/* 模板 3: 胶片底栏 */
.film-bar-wrapper {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  pointer-events: auto;
  z-index: 3;
}

.film-floating-qr {
  position: absolute;
  right: 20rpx;
  bottom: 116rpx;
}

.wm-tpl-film-full {
  width: 100%;
  box-sizing: border-box;
  border-top: 3rpx solid #38bdf8;
  padding: 14rpx 22rpx;
}

.wm-film-row-top,
.wm-film-row-bottom {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.wm-film-row-bottom {
  margin-top: 6rpx;
}

.wm-film-poi {
  font-size: 24rpx;
  font-weight: bold;
  color: #ffffff;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 55%;
}

.wm-film-time {
  font-size: 19rpx;
  color: #e2e8f0;
  flex-shrink: 0;
}

.wm-film-coord-full {
  font-size: 19.5rpx;
  font-weight: bold;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  flex: 1;
}

.wm-film-badge {
  font-size: 18rpx;
  max-width: 36%;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  flex-shrink: 0;
}

/* 二维码预览角标 */
.wm-qr-preview-badge {
  width: 118rpx;
  background-color: rgba(11, 19, 43, 0.92);
  border: 1.5px solid #38bdf8;
  border-radius: 14rpx;
  padding: 8rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
}

.wm-qr-box {
  width: 96rpx;
  height: 96rpx;
  background-color: #ffffff;
  border-radius: 6rpx;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

.wm-qr-finder {
  position: absolute;
  width: 24rpx;
  height: 24rpx;
  border: 4rpx solid #000000;
  box-sizing: border-box;
}

.wm-qr-finder.tl { top: 8rpx; left: 8rpx; }
.wm-qr-finder.tr { top: 8rpx; right: 8rpx; }
.wm-qr-finder.bl { bottom: 8rpx; left: 8rpx; }

.wm-qr-center-dot {
  font-size: 16rpx;
  font-weight: bold;
  color: #0284c7;
}

.wm-qr-txt {
  font-size: 16rpx;
  font-weight: bold;
  margin-top: 6rpx;
  white-space: nowrap;
}
