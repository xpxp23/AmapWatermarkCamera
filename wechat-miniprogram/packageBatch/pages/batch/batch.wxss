.batch-page {
  width: 100vw;
  height: 100vh;
  background-color: #050811;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.nav-header {
  background-color: rgba(11, 19, 43, 0.92);
  border-bottom: 1px solid rgba(148, 163, 184, 0.16);
  padding-left: 20rpx;
  padding-bottom: 14rpx;
  display: flex;
  align-items: center;
  box-sizing: content-box;
  position: relative;
}

.nav-back {
  display: flex;
  align-items: center;
  padding: 6rpx 16rpx 6rpx 8rpx;
  border-radius: 28rpx;
  background-color: rgba(30, 41, 59, 0.78);
}

.nav-chevron {
  font-size: 36rpx;
  line-height: 1;
  margin-right: 4rpx;
}

.nav-back-txt {
  font-size: 24rpx;
}

.nav-title {
  margin-left: 20rpx;
  font-size: 30rpx;
  font-weight: bold;
  color: #ffffff;
}

.batch-scroll {
  flex: 1;
  min-height: 0;
  padding: 20rpx;
  box-sizing: border-box;
}

.config-card,
.progress-card {
  background-color: #0f172a;
  border: 1px solid rgba(56, 189, 248, 0.25);
  border-radius: 22rpx;
  padding: 20rpx;
  margin-bottom: 18rpx;
}

.card-row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
}

.card-section-title {
  font-size: 25rpx;
  font-weight: bold;
  color: #f8fafc;
}

.exif-toggle-pill {
  font-size: 20rpx;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  background-color: rgba(30, 41, 59, 0.85);
  border: 1px solid rgba(148, 163, 184, 0.35);
  color: #cbd5e1;
}

.exif-toggle-pill.on {
  background-color: rgba(5, 150, 105, 0.25);
  border-color: #34d399;
  color: #34d399;
  font-weight: bold;
}

.tpl-chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 14rpx;
}

.tpl-chip {
  padding: 8rpx 16rpx;
  border-radius: 16rpx;
  background-color: #1e293b;
  color: #94a3b8;
  font-size: 21rpx;
}

.tpl-chip.active {
  background-color: rgba(2, 132, 199, 0.28);
  border: 1px solid #38bdf8;
  color: #38bdf8;
  font-weight: bold;
}

.inline-field-row {
  display: flex;
  gap: 12rpx;
}

.batch-input {
  flex: 1;
  height: 68rpx;
  background-color: #1e293b;
  border: 1px solid rgba(148, 163, 184, 0.22);
  border-radius: 12rpx;
  padding: 0 16rpx;
  color: #ffffff;
  font-size: 22rpx;
}

.scrim-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 14rpx;
  padding-top: 12rpx;
  border-top: 1px solid rgba(148, 163, 184, 0.14);
}

.scrim-lbl {
  font-size: 22rpx;
  color: #cbd5e1;
}

.progress-head {
  display: flex;
  justify-content: space-between;
  font-size: 22rpx;
  margin-bottom: 10rpx;
}

.progress-txt {
  color: #cbd5e1;
}

.progress-pct {
  font-weight: bold;
}

.progress-track {
  height: 12rpx;
  background-color: #1e293b;
  border-radius: 6rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #0284c7, #34d399);
  border-radius: 6rpx;
}

.empty-box {
  background-color: #0f172a;
  border: 2rpx dashed rgba(56, 189, 248, 0.45);
  border-radius: 26rpx;
  padding: 64rpx 36rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.empty-icon {
  font-size: 76rpx;
  margin-bottom: 16rpx;
}

.empty-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #ffffff;
}

.empty-sub {
  font-size: 22rpx;
  color: #94a3b8;
  margin-top: 12rpx;
  line-height: 1.6;
}

.empty-cta {
  margin-top: 28rpx;
  padding: 16rpx 44rpx;
  border-radius: 36rpx;
  background-color: #0284c7;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: bold;
}

.queue-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
}

.queue-title {
  font-size: 25rpx;
  font-weight: bold;
}

.queue-ops {
  display: flex;
  gap: 24rpx;
}

.op-link {
  font-size: 23rpx;
  font-weight: bold;
}

.queue-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  padding-bottom: 24rpx;
}

.queue-card {
  width: calc((100% - 24rpx) / 3);
  height: 240rpx;
  border-radius: 16rpx;
  overflow: hidden;
  position: relative;
  background-color: #1e293b;
}

.queue-thumb {
  width: 100%;
  height: 100%;
}

.queue-del {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 38rpx;
  height: 38rpx;
  border-radius: 19rpx;
  background-color: rgba(0, 0, 0, 0.72);
  color: #ffffff;
  font-size: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.queue-exif-tag {
  position: absolute;
  top: 8rpx;
  left: 8rpx;
  padding: 2rpx 8rpx;
  border-radius: 8rpx;
  background-color: rgba(11, 19, 43, 0.82);
  color: #38bdf8;
  font-size: 16rpx;
}

.queue-status-bar {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 6rpx 0;
  text-align: center;
  font-size: 19rpx;
  font-weight: bold;
  background-color: rgba(15, 23, 42, 0.85);
  color: #cbd5e1;
}

.queue-status-bar.processing {
  background-color: rgba(2, 132, 199, 0.88);
  color: #ffffff;
}

.queue-status-bar.success {
  background-color: rgba(5, 150, 105, 0.9);
  color: #ffffff;
}

.queue-status-bar.failed {
  background-color: rgba(220, 38, 38, 0.9);
  color: #ffffff;
}

.batch-footer {
  background-color: #0b132b;
  border-top: 1px solid rgba(148, 163, 184, 0.16);
  padding: 16rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  display: flex;
  gap: 14rpx;
}

.footer-btn {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  border-radius: 18rpx;
  font-size: 26rpx;
  font-weight: bold;
  color: #ffffff;
}

.footer-btn.primary { background-color: #0284c7; }
.footer-btn.amber { background-color: #d97706; }
.footer-btn.danger { background-color: #dc2626; }
